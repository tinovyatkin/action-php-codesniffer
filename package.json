{
  "name": "typescript-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript template action",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --sourcemap --legal-comments=linked --define:import.meta.dirname=__dirname",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test '**/*.test.ts'",
    "all": "npm run build && npm run format && npm run lint && npm run bundle && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "YourNameOrOrganization",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@actions/core": "2.0.2",
    "@actions/github": "7.0.0",
    "git-blame-json": "1.0.2",
    "php-codesniffer": "1.0.2",
    "picomatch": "4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.10.7",
    "@types/picomatch": "4.0.2",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0"
  }
}
